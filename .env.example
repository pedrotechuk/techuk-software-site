APP_NAME="Techuk Software"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Em producao use a URL final, ex.: https://techuksoftware.com.br
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=info

# O site nao usa banco de dados.
DB_CONNECTION=null
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Medicao. Vazio = o script nao e carregado. Mesmo com ID, so carrega apos o consentimento do visitante.
GA4_ID=
META_PIXEL_ID=

# Mostra o aviso de rascunho nas paginas de Politica e Termos. Ponha false depois da revisao juridica.
LEGAL_DRAFT_NOTICE=true

VITE_APP_NAME="${APP_NAME}"
